# Never commit the real .env.

# AI provider: set ONE key.
# Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Anthropic (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# If both keys are set, Anthropic is used unless LLM_PROVIDER=gemini.
# LLM_PROVIDER=

# Accounts and database (Supabase). See "Accounts (Supabase)" in the README.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design: the page uses it to sign people in.
SUPABASE_PUBLISHABLE_KEY=
# Session pooler connection string (not the direct one), with the database password filled in.
DATABASE_URL=
# Optional: Supabase's root certificate (PEM text) so the database certificate is verified.
# DATABASE_SSL_CA=
# Only for older projects that still sign tokens with a shared secret.
# SUPABASE_JWT_SECRET=

# Who can open the admin page (comma-separated emails).
ADMIN_EMAILS=
# Where "today" starts for the free daily limit and the usage view.
TIMEZONE=America/Tegucigalpa

PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 on Render or to let other devices on your network connect.
HOST=127.0.0.1

# Token cap per call (input + output, turns + feedback).
SESSION_TOKEN_CAP=20000
# Part of the cap kept back so a call can always get its feedback.
FEEDBACK_TOKEN_RESERVE=4000

# Rate limits per account (window in seconds).
RATE_TURN_MAX=40
RATE_TURN_WINDOW_SEC=600
RATE_FEEDBACK_MAX=6
RATE_FEEDBACK_WINDOW_SEC=600

# Call length (customer turns).
MIN_TURNS=6
MAX_TURNS=10

# Sites allowed to call this server from a browser (comma-separated, no paths).
# ALLOWED_ORIGINS=https://callreadyhn.com,https://www.callreadyhn.com,https://nesrey.github.io
ALLOWED_ORIGINS=
