# AI provider: set ONE key. Never commit the real .env.
# Anthropic (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# If both keys are set, Anthropic is used unless LLM_PROVIDER=gemini.
# LLM_PROVIDER=

PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to let other devices on your network connect.
HOST=127.0.0.1

# Token cap per call session (input + output, turns + feedback).
SESSION_TOKEN_CAP=20000
# Part of the cap kept back so a call can always get its feedback.
FEEDBACK_TOKEN_RESERVE=4000

# Rate limits per device id (window in seconds).
RATE_TURN_MAX=40
RATE_TURN_WINDOW_SEC=600
RATE_FEEDBACK_MAX=6
RATE_FEEDBACK_WINDOW_SEC=600

# Call length (customer turns).
MIN_TURNS=6
MAX_TURNS=10

# Other sites allowed to call this server from a browser (comma-separated, no paths).
# Needed only when the page is hosted somewhere else, e.g. GitHub Pages:
# ALLOWED_ORIGINS=https://nesrey.github.io
ALLOWED_ORIGINS=
