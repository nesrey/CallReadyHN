{
  "name": "callready-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
